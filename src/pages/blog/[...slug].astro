---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const lessons = (await getCollection('blog'))
  .filter((lesson) => lesson.data.trail === post.data.trail)
  .sort((a, b) => a.data.order - b.data.order);
const index = lessons.findIndex((lesson) => lesson.id === post.id);
const navigationEntry = (lesson: CollectionEntry<'blog'> | undefined) => lesson && ({ id: lesson.id, title: lesson.data.title });
---

<BlogPost {...post.data} previous={navigationEntry(lessons[index - 1])} next={navigationEntry(lessons[index + 1])}>
	<Content />
</BlogPost>
